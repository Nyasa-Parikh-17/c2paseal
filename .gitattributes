# Text files are checked out with LF on every OS, so release builds are
# reproducible from a Windows checkout (README, LICENSE and CHANGELOG go into
# the archives, and web/site is embedded in the binary).
* text=auto eol=lf
*.sh text eol=lf
# Fixtures and oracle output must stay byte-exact on every OS, and so must
# the site's copies of the demo PKI (TestDemoPKI). Later lines win, so these
# stay last.
testdata/** -text
web/site/demo/** -text
